# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Environments and secrets (never commit credentials, tokens, or keys)
.venv/
.venv-ryu/
venv/
.env
.env.*

# Datasets: never commit raw or processed data.
# Only data/README.md and MANIFEST.md files are tracked.
data/**
!data/**/
!data/README.md
!data/**/MANIFEST.md
!data/**/.gitkeep
!data/live/*.csv
!data/live/*.json

# Large experiment outputs (small CSV/JSON summaries in results/ stay tracked)
results/**/*.log
results/**/*.jsonl
results/**/*.pt
results/**/*.pth
results/**/*.npy
results/**/*.npz
results/**/*.pcap
results/**/*.pcapng

# Testbed captures
*.pcap
*.pcapng

# Notebooks and IDEs
.ipynb_checkpoints/
.vscode/*
!.vscode/launch.json
.idea/

# Interactive studio runtime files
demo/artifacts/vm_tmp/
demo/artifacts/vm_config.json
demo/artifacts/studio_blocklist.json
results/08_live/live_ovs_flows.txt

# Website build output
site/dist/
site/node_modules/
