# Reference L3 Multi-VM Provisioning Specification for TrustFed-SDN
# Active laptop execution uses L1 inside the single Ubuntu 22.04 LTS VMware guest (15.67 GB host RAM).

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"

  # SDN Controller & FL Coordinator VM
  config.vm.define "sdn-controller" do |ctrl|
    ctrl.vm.hostname = "trustfed-ctrl"
    ctrl.vm.network "private_network", ip: "10.10.250.10", auto_config: true
    ctrl.vm.provider "virtualbox" do |vb|
      vb.memory = 2048
      vb.cpus = 2
    end
  end

  # Three Tenant Victim + Attacker + Benign VMs (10.10.{1,2,3}.0/24)
  [
    { name: "t1-finance", subnet: "10.10.1" },
    { name: "t2-healthcare", subnet: "10.10.2" },
    { name: "t3-education", subnet: "10.10.3" }
  ].each do |t|
    { "benign" => 10, "victim" => 50, "attacker" => 100 }.each do |role, octet|
      config.vm.define "#{t[:name]}-#{role}" do |node|
        node.vm.hostname = "#{t[:name]}-#{role}"
        node.vm.network "private_network", ip: "#{t[:subnet]}.#{octet}"
        node.vm.provider "virtualbox" do |vb|
          vb.memory = 1024
          vb.cpus = 1
        end
      end
    end
  end
end
